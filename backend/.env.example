# LLM Provider: "ollama" (local, fully free) or "groq" (free cloud tier)
LLM_PROVIDER=ollama

# Ollama settings (if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Groq free tier (if LLM_PROVIDER=groq) — sign up free at console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile

# Image source: "pexels" (free API key) or "duckduckgo" (no key needed)
IMAGE_SOURCE=duckduckgo

# Pexels free API (if IMAGE_SOURCE=pexels) — free at pexels.com/api
PEXELS_API_KEY=your_pexels_api_key_here

# TTS: edge-tts is always used (completely free, no key needed)
# Voice options: en-US-AriaNeural, en-US-GuyNeural, en-GB-SoniaNeural, en-AU-NatashaNeural
TTS_VOICE=en-US-AriaNeural
TTS_RATE=+0%
TTS_PITCH=+0Hz

# Video output settings
OUTPUT_DIR=./outputs
TEMP_DIR=./temp
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=24

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000
